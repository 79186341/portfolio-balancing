generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One account being balanced, like a TFSA or RRSP: cash on hand, cash you want
/// to keep, how its plan may trade, and the last fetched USD/CAD rate.
model Portfolio {
  id              Int        @id @default(autoincrement())
  name            String     @default("My portfolio")
  cashCad         Float      @default(0)
  cashUsd         Float      @default(0)
  targetCashCad   Float      @default(0)
  targetCashUsd   Float      @default(0)
  /// false = only buy with available cash (no sells)
  allowSells      Boolean    @default(true)
  /// false = each currency's cash only buys funds listed in that currency
  allowConversion Boolean    @default(true)
  /// true = trades can be fractions of a share
  allowFractional Boolean    @default(false)
  /// CAD per 1 USD
  usdCad          Float?
  usdCadSource    String?
  usdCadAsOf      DateTime?
  pricesAsOf      DateTime?
  assets          Asset[]
  snapshots       Snapshot[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
}

model Asset {
  id            Int       @id @default(autoincrement())
  portfolioId   Int
  portfolio     Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  /// Ticker without exchange suffix, e.g. "XIC" or "AVUV"
  symbol        String
  name          String    @default("")
  /// Trading currency, which also picks the exchange: "CAD" (TSX) or "USD" (US)
  currency      String
  targetPercent Float
  units         Float     @default(0)
  position      Int       @default(0)
  /// Last price in the asset's own currency
  price         Float?
  priceSource   String?
  priceAsOf     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([portfolioId, symbol, currency])
}

/// A labelled copy of the holdings, cash and prices at one moment, kept for
/// comparing over time. Later edits to the portfolio don't change it.
model Snapshot {
  id            Int             @id @default(autoincrement())
  portfolioId   Int
  portfolio     Portfolio       @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  label         String
  cashCad       Float
  cashUsd       Float
  targetCashCad Float
  targetCashUsd Float
  /// CAD per 1 USD when the snapshot was saved
  usdCad        Float?
  pricesAsOf    DateTime?
  assets        SnapshotAsset[]
  createdAt     DateTime        @default(now())
}

model SnapshotAsset {
  id            Int      @id @default(autoincrement())
  snapshotId    Int
  snapshot      Snapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  symbol        String
  name          String
  currency      String
  targetPercent Float
  units         Float
  position      Int
  /// Price in the asset's own currency, null if it hadn't loaded
  price         Float?
}
